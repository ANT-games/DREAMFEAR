			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const insts = runtime.objects.metaUpgradeSlot.getAllInstances();",
						"const unlocked = [];",
						"for (const inst of insts) {",
						"  if (!inst.instVars.locked) unlocked.push(inst);",
						"}",
						"for (const u of unlocked) {",
						"  const x = u.instVars.Xupgrade;",
						"  const y = u.instVars.Yupgrade;",
						"  for (const inst of insts) {",
						"    if (inst.instVars.Xupgrade === x + 1 && inst.instVars.Yupgrade === y) inst.instVars.availvable = true;",
						"    if (inst.instVars.Yupgrade === y + 1 && inst.instVars.Xupgrade === x) inst.instVars.availvable = true;",
						"  }",
						"}"
					]
				}
			],
